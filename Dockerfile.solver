# syntax=docker/dockerfile:1.7

# Build from the repository root:
#   docker build -f Dockerfile.solver -t firmament-solver .
FROM rust:1.85-bookworm AS builder

WORKDIR /src
ENV CARGO_TERM_COLOR=always

COPY Cargo.toml Cargo.lock ./
COPY src/lib.rs src/main.rs ./src/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo fetch --locked

COPY src ./src

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --locked --release --bin firmament \
    && mkdir -p /out \
    && cp /src/target/release/firmament /out/firmament

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system firmament \
    && useradd --system --gid firmament --home-dir /app --shell /usr/sbin/nologin firmament \
    && mkdir -p /app /data \
    && chown -R firmament:firmament /app /data

WORKDIR /app

COPY --from=builder /out/firmament /usr/local/bin/firmament
COPY --chmod=755 docker/solver-entrypoint.sh /usr/local/bin/solver-entrypoint

ENV RUST_LOG=info

EXPOSE 5050
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:5050/health >/dev/null || exit 1

USER firmament
ENTRYPOINT ["solver-entrypoint"]
CMD ["firmament"]
