{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://shaikazeem.mintlify.dev/docs"
    },
    {
      "source": "/docs/",
      "destination": "https://shaikazeem.mintlify.dev/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://shaikazeem.mintlify.dev/docs/:match*"
    },
    {
      "source": "/app",
      "destination": "https://firmament-app.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://firmament-app.vercel.app/app/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://firmament-app.vercel.app/fonts/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api.firmament.shaikazeem.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.firmament.shaikazeem.com/health"
    }
  ]
}
