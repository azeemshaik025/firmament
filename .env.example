# Solana RPC
SOLANA_RPC_URL=

# Maker/operator wallet. Set exactly one source.
MAKER_PRIVATE_KEY=
# MAKER_KEYPAIR_PATH=<absolute-path-to-maker-keypair-json>
# MAKER_KEYPAIR_JSON=<maker-keypair-json-array>

# Taker/app wallet for legacy local-signing demo flows. Browser-wallet settlement does not need this.

# Jupiter Swap API V2
JUPITER_API_KEY=

# Circle Gateway. This must be the Solana depositor address approved in Circle Gateway.
CIRCLE_GATEWAY_SOLANA_ADDRESS=

# Admin dashboard auth. Generate an Argon2id PHC hash for the admin password and set:
# FIRMAMENT_ADMIN_PASSWORD_HASHES='admin=$argon2id$...'
FIRMAMENT_ADMIN_PASSWORD_HASHES=
FIRMAMENT_ADMIN_SESSION_SECRET=
