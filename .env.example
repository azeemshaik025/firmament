# Solana RPC
SOLANA_RPC_URL=<solana-mainnet-rpc-url>

# Maker/operator wallet. Use either path or JSON, not both.
MAKER_KEYPAIR_PATH=<absolute-path-to-maker-keypair-json>
MAKER_KEYPAIR_JSON=<maker-keypair-json-array>

# Taker/app wallet. Use either path or JSON, not both.
TAKER_KEYPAIR_PATH=<absolute-path-to-taker-keypair-json>
TAKER_KEYPAIR_JSON=<taker-keypair-json-array>

# Jupiter Swap API V2
JUPITER_API_KEY=<jupiter-api-key>

# Circle Gateway placeholders
CIRCLE_API_KEY=<circle-api-key>
CIRCLE_ENTITY_SECRET=<circle-entity-secret>
CIRCLE_GATEWAY_WALLET_ID=<circle-gateway-wallet-id>
CIRCLE_GATEWAY_SOLANA_ADDRESS=<circle-gateway-solana-address>

# Local operator API auth
OPERATOR_API_TOKEN=<operator-api-token>
